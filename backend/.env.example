# ai_agent_companion backend 环境变量模板
#
# 用法：复制为 .env 并填写真实值；或运行 `pixi run setup` 交互式生成。
# 分层加载链（优先级从低到高）：代码默认值 < .env < 进程环境变量；
# config.yaml / extensions_config.json 承载结构化配置（llm 模型注册表 /
# 角色绑定 / 多模态回退链 / 工具清单），与 env 面不重叠。
#
# 所有变量名必须 UPPERCASE_WITH_UNDERSCORES。
#
# 本文件由 `pixi run gen-examples` 从 packages/harness/config 的 Pydantic 配置类自动生成。
# 不要手动编辑——请修改配置类的 Field(description=...) 后重新生成。

# ===========================================================================
# SERVER — Web 服务配置
# ===========================================================================
# 服务监听地址
SERVER_HOST=127.0.0.1

# 服务监听端口
SERVER_PORT=8000

# uvicorn worker 进程数（生产模式）
SERVER_WORKERS=1

# ===========================================================================
# DATABASE — 数据库连接配置（MySQL 8 权威 / SQLite 测试）
# ===========================================================================
# 数据库类型：mysql（生产权威）/ sqlite（测试）
DATABASE_TYPE=mysql

# MySQL 主机地址
DATABASE_HOST=127.0.0.1

# MySQL 端口
DATABASE_PORT=3306

# MySQL 数据库名；sqlite 方言下为库文件路径（:memory: 内存库）
DATABASE_NAME=ai_agent_companion

# MySQL 用户名
DATABASE_USER=root

# MySQL 密码
DATABASE_PASSWORD=

# 连接池常驻连接数
DATABASE_POOL_SIZE=10

# 连接池溢出上限
DATABASE_MAX_OVERFLOW=20

# 连接回收周期（秒）
DATABASE_POOL_RECYCLE=3600

# 取出连接前健康检查
DATABASE_POOL_PRE_PING=true

# ===========================================================================
# LOG — 日志配置（三 sink：console + 文本 + JSON）
# ===========================================================================
# 全局日志级别
LOG_LEVEL=INFO

# 文本日志文件路径
LOG_FILE=logs/app.log

# JSON 日志文件路径
LOG_JSON_FILE=logs/app.json.log

# 轮转策略（每日轮转）
LOG_ROTATION=1 day

# 保留时长（30 天）
LOG_RETENTION=30 days

# 按模块覆盖级别规格串
LOG_MODULE_LEVELS=

# console sink 彩色输出
LOG_COLORIZE_CONSOLE=true

# ===========================================================================
# POOLS — 共享池配置（线程池 / HTTP 池 / LLM 信号量 / 熔断）
# ===========================================================================
# 共享线程池大小
POOLS_THREAD_POOL_SIZE=8

# HTTP 池最大连接数
POOLS_HTTP_MAX_CONNECTIONS=100

# HTTP 池 keepalive 连接数
POOLS_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# HTTP 连接建立超时（秒）
POOLS_HTTP_CONNECT_TIMEOUT_SECONDS=5.0

# HTTP 单请求总超时（秒）
POOLS_HTTP_TIMEOUT_SECONDS=30.0

# LLM 全局并发信号量上限（条目级回落值）
POOLS_LLM_SEMAPHORE_LIMIT=5

# LLM 单请求超时（秒；网关消费）
POOLS_LLM_REQUEST_TIMEOUT_SECONDS=120

# 熔断失败阈值（连续失败次数）
POOLS_CB_FAIL_MAX=5

# 熔断冷却秒数
POOLS_CB_RESET_TIMEOUT_SECONDS=60

# ===========================================================================
# LLM — 默认端点 env 面（模型注册表经 config.yaml 配置）
# ===========================================================================
# 默认端点 API 基础 URL
LLM_BASE_URL=

# 默认端点 API Key
LLM_API_KEY=

# 默认端点模型名
LLM_MODEL=

# ===========================================================================
# ENV — 运行环境标识
# ===========================================================================
# 运行环境标识（local / dev / prod）
ENV=local
