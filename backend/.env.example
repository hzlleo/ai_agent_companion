# ai_agent_companion backend 环境变量模板
#
# 用法：复制为 .env 并填写真实值；或运行 `pixi run setup` 交互式生成。
# 分层加载链（优先级从低到高）：代码默认值 < .env < 进程环境变量；
# config.yaml / extensions_config.json 承载结构化配置（llm 模型注册表 /
# 角色绑定 / 多模态回退链 / 工具清单），与 env 面不重叠。
#
# 所有变量名必须 UPPERCASE_WITH_UNDERSCORES。
#
# 本文件由 `pixi run gen-examples` 从 packages/harness/config 的 Pydantic 配置类自动生成。
# 不要手动编辑——请修改配置类的 Field(description=...) 后重新生成。

# ===========================================================================
# SERVER — Web 服务配置
# ===========================================================================
# 服务监听地址
SERVER_HOST=127.0.0.1

# 服务监听端口
SERVER_PORT=8000

# uvicorn worker 进程数（生产模式）
SERVER_WORKERS=1

# 管理面 owner-token 鉴权环境变量名（空 = 鉴权关闭；公网暴露必须配置）
SERVER_ADMIN_TOKEN_ENV=

# ===========================================================================
# DATABASE — 数据库连接配置（MySQL 8 权威 / SQLite 测试）
# ===========================================================================
# 数据库类型：mysql（生产权威）/ sqlite（测试）
DATABASE_TYPE=mysql

# MySQL 主机地址
DATABASE_HOST=127.0.0.1

# MySQL 端口
DATABASE_PORT=3306

# MySQL 数据库名；sqlite 方言下为库文件路径（:memory: 内存库）
DATABASE_NAME=ai_agent_companion

# MySQL 用户名
DATABASE_USER=root

# MySQL 密码
DATABASE_PASSWORD=

# 连接池常驻连接数
DATABASE_POOL_SIZE=10

# 连接池溢出上限
DATABASE_MAX_OVERFLOW=20

# 连接回收周期（秒）
DATABASE_POOL_RECYCLE=3600

# 取出连接前健康检查
DATABASE_POOL_PRE_PING=true

# ===========================================================================
# LOG — 日志配置（三 sink：console + 文本 + JSON）
# ===========================================================================
# 全局日志级别
LOG_LEVEL=INFO

# 文本日志文件路径
LOG_FILE=logs/app.log

# JSON 日志文件路径
LOG_JSON_FILE=logs/app.json.log

# 轮转策略（每日轮转）
LOG_ROTATION=1 day

# 保留时长（30 天）
LOG_RETENTION=30 days

# 按模块覆盖级别规格串
LOG_MODULE_LEVELS=

# console sink 彩色输出
LOG_COLORIZE_CONSOLE=true

# 异常 diagnose（traceback 帧变量展示；默认关闭防密钥泄漏）
LOG_DIAGNOSE_EXCEPTIONS=false

# ===========================================================================
# POOLS — 共享池配置（线程池 / HTTP 池 / LLM 信号量 / 熔断）
# ===========================================================================
# 共享线程池大小
POOLS_THREAD_POOL_SIZE=8

# HTTP 池最大连接数
POOLS_HTTP_MAX_CONNECTIONS=100

# HTTP 池 keepalive 连接数
POOLS_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# HTTP 连接建立超时（秒）
POOLS_HTTP_CONNECT_TIMEOUT_SECONDS=5.0

# HTTP 单请求总超时（秒）
POOLS_HTTP_TIMEOUT_SECONDS=30.0

# LLM 全局并发信号量上限（条目级回落值）
POOLS_LLM_SEMAPHORE_LIMIT=5

# LLM 单请求超时（秒；网关消费）
POOLS_LLM_REQUEST_TIMEOUT_SECONDS=120

# 熔断失败阈值（连续失败次数）
POOLS_CB_FAIL_MAX=5

# 熔断冷却秒数
POOLS_CB_RESET_TIMEOUT_SECONDS=60

# ===========================================================================
# LLM — 默认端点 env 面（模型注册表经 config.yaml 配置）
# ===========================================================================
# 默认端点 API 基础 URL
LLM_BASE_URL=

# 默认端点 API Key
LLM_API_KEY=

# 默认端点模型名
LLM_MODEL=

# ===========================================================================
# SEEKDB — 检索存储配置（enabled=False 走 SQLite 回退；密码经 SEEKDB_PASSWORD 间接）
# ===========================================================================
# 是否启用 SeekDB 检索存储（False = SQLite 回退）
SEEKDB_ENABLED=false

# SeekDB 服务地址
SEEKDB_HOST=127.0.0.1

# SeekDB MySQL 线协议端口
SEEKDB_PORT=2881

# SeekDB 连接用户名
SEEKDB_USER=root

# SeekDB 密码环境变量名
SEEKDB_PASSWORD_ENV=

# SeekDB 连接库名
SEEKDB_DATABASE=test

# 向量维度（须与 embed 模型输出一致）
SEEKDB_VECTOR_DIM=1024

# 连接池常驻连接数
SEEKDB_POOL_MIN=1

# 连接池连接上限
SEEKDB_POOL_MAX=4

# ===========================================================================
# CHANNELS.TELEGRAM — Telegram 通道配置（机器人令牌经 TELEGRAM_BOT_TOKEN 间接）
# ===========================================================================
# 是否启用 Telegram 通道
TELEGRAM_ENABLED=false

# bot token 环境变量名
TELEGRAM_BOT_TOKEN_ENV=

# Bot API 基础 URL
TELEGRAM_API_BASE=https://api.telegram.org

# getUpdates 长轮询超时秒数（Bot API 上限 50）
TELEGRAM_POLL_TIMEOUT_SECONDS=25

# 属主会话 ID（duty 通知目标；None = 未配置）
TELEGRAM_OWNER_CHAT_ID=

# 退避基数秒
TELEGRAM_BACKOFF_BASE_SECONDS=1.0

# 退避封顶秒数
TELEGRAM_BACKOFF_MAX_SECONDS=60.0

# 通道状态目录（offset 持久化）
TELEGRAM_STATE_DIR=data/channels

# ===========================================================================
# CHANNELS.QQ — QQ 通道配置（NapCat OneBot v11；令牌经 QQ_ACCESS_TOKEN / QQ_WEBHOOK_TOKEN 间接）
# ===========================================================================
# 是否启用 QQ 通道
QQ_ENABLED=false

# NapCat HTTP API 基础 URL
QQ_HTTP_API_BASE_URL=http://127.0.0.1:3000

# 出站 access token 环境变量名
QQ_ACCESS_TOKEN_ENV=

# 入站 webhook 校验 token 环境变量名
QQ_WEBHOOK_TOKEN_ENV=

# 单次动作请求超时（秒）
QQ_REQUEST_TIMEOUT_SECONDS=15.0

# ===========================================================================
# DUTY — 值班轮配置（charter 工具循环 + 报告属主投递）
# ===========================================================================
# 是否启用值班轮
DUTY_ENABLED=false

# 每日值班时刻（HH:MM）
DUTY_DAILY_AT=22:00

# 单轮工具调用步数上限
DUTY_MAX_TOOL_STEPS=8

# 值班报告是否投递属主
DUTY_REPORT_TO_OWNER=true

# 值班任务书覆写（None = 正典模板）
DUTY_CHARTER_TEXT=

# ===========================================================================
# DREAM_SCHEDULE — 夜间梦境定时触发配置
# ===========================================================================
# 是否启用梦境定时调度
DREAM_SCHEDULE_ENABLED=false

# 每日梦境时刻（HH:MM）
DREAM_SCHEDULE_DAILY_AT=03:00

# ===========================================================================
# SCHEDULER — 中央调度器配置（自研异步循环）
# ===========================================================================
# 调度器 tick 循环间隔秒
SCHEDULER_TICK_SECONDS=1.0

# ===========================================================================
# TOOLS_SANDBOX — 工具沙盒配置（可选运行时；令牌经 SANDBOX_TOKEN 间接）
# ===========================================================================
# 是否启用工具沙盒
TOOLS_SANDBOX_ENABLED=false

# 沙盒服务基础 URL
TOOLS_SANDBOX_BASE_URL=http://127.0.0.1:8765

# 鉴权 token 环境变量名
TOOLS_SANDBOX_TOKEN_ENV=

# 单次请求超时（invoke / 健康探测共用）
TOOLS_SANDBOX_REQUEST_TIMEOUT_SECONDS=15.0

# ===========================================================================
# TOOLS_BROWSER_SIDECAR — 浏览器 sidecar 配置（可选运行时；令牌经 BROWSER_SIDECAR_TOKEN 间接；容器侧 BROWSER_SIDECAR_* 键见 compose）
# ===========================================================================
# 是否启用浏览器 sidecar
TOOLS_BROWSER_SIDECAR_ENABLED=false

# sidecar 服务基础 URL
TOOLS_BROWSER_SIDECAR_BASE_URL=http://127.0.0.1:8766

# 鉴权 token 环境变量名
TOOLS_BROWSER_SIDECAR_TOKEN_ENV=

# 单次请求超时（invoke / 健康探测共用）
TOOLS_BROWSER_SIDECAR_REQUEST_TIMEOUT_SECONDS=30.0

# ===========================================================================
# VOICE.TTS — 语音合成配置（CosyVoice3 服务端点）
# ===========================================================================
# 是否启用 TTS 语音合成
VOICE_TTS_ENABLED=false

# CosyVoice 包装服务基础 URL
VOICE_TTS_BASE_URL=http://127.0.0.1:9880

# 用量记账模型条目名
VOICE_TTS_MODEL_ENTRY=cosyvoice3

# 单次合成请求超时（秒）
VOICE_TTS_REQUEST_TIMEOUT_SECONDS=30.0

# 缺省发音人（CosyVoice 预置 speaker）
VOICE_TTS_DEFAULT_SPEAKER=中文女

# 缺省语速（0.5-2.0）
VOICE_TTS_DEFAULT_SPEED=1.0

# ===========================================================================
# VOICE.ASR — 语音识别配置（Qwen3-ASR 服务端点）
# ===========================================================================
# 是否启用 ASR 语音识别
VOICE_ASR_ENABLED=false

# Qwen3-ASR 服务基础 URL
VOICE_ASR_BASE_URL=http://127.0.0.1:8082

# 用量记账模型条目名（兼模型 id）
VOICE_ASR_MODEL_ENTRY=qwen3-asr-0.6b

# 单次转写请求超时（秒）
VOICE_ASR_REQUEST_TIMEOUT_SECONDS=60.0

# 缺省语言提示（None = 端点自动检测）
VOICE_ASR_LANGUAGE=

# ASR 上传请求体上限（字节；25MB 量级——音频体积天然大于截图，与 look_at 图像 10MB 上限同为资源面守卫）
VOICE_ASR_MAX_UPLOAD_BYTES=26214400

# ===========================================================================
# SEARCH.WEB — 联网搜索运营配置（默认关闭；密钥经 SEARCH_BOCHA_API_KEY / SEARCH_ZHIPU_API_KEY 间接——条目表在 config.yaml search 节管理）
# ===========================================================================
# 是否启用联网搜索能力
SEARCH_ENABLED=false

# 是否注册 web_search 工具（需 enabled 同时为真）
SEARCH_TOOL_ENABLED=false

# 单人格每日搜索调用数预算
SEARCH_DAILY_BUDGET_PER_PERSONA=50

# 全局每日搜索调用数预算
SEARCH_DAILY_BUDGET_GLOBAL=200

# provider 失败降级冷却秒数
SEARCH_COOLDOWN_SECONDS=60

# ===========================================================================
# ENV — 运行环境标识
# ===========================================================================
# 运行环境标识（local / dev / prod）
ENV=local
