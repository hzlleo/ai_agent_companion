# ai_agent_companion backend 环境变量模板
#
# 用法：复制为 .env 并填写真实值；或运行 `pixi run setup` 交互式生成。
# 分层加载链（优先级从低到高）：代码默认值 < .env < 进程环境变量；
# config.yaml / extensions_config.json 承载结构化配置（llm 模型注册表 /
# 角色绑定 / 多模态回退链 / 工具清单），与 env 面不重叠。
#
# 所有变量名必须 UPPERCASE_WITH_UNDERSCORES。
#
# 本文件由 `pixi run gen-examples` 从 packages/harness/config 的 Pydantic 配置类自动生成。
# 不要手动编辑——请修改配置类的 Field(description=...) 后重新生成。

# ===========================================================================
# SERVER — Web 服务配置
# ===========================================================================
# 服务监听地址
SERVER_HOST=127.0.0.1

# 服务监听端口
SERVER_PORT=8000

# uvicorn worker 进程数（生产模式）
SERVER_WORKERS=1

# 管理面 owner-token 鉴权环境变量名（空 = 开发/测试鉴权关闭；生产 ENV=prod 强制非空）
SERVER_ADMIN_TOKEN_ENV=

# ===========================================================================
# DATABASE — 数据库连接配置（MySQL 8 权威 / SQLite 测试）
# ===========================================================================
# 数据库类型：mysql（生产权威）/ sqlite（测试）
DATABASE_TYPE=mysql

# MySQL 主机地址
DATABASE_HOST=127.0.0.1

# MySQL 端口
DATABASE_PORT=3306

# MySQL 数据库名；sqlite 方言下为库文件路径（:memory: 内存库）
DATABASE_NAME=ai_agent_companion

# MySQL 用户名
DATABASE_USER=root

# MySQL 密码
DATABASE_PASSWORD=

# 连接池常驻连接数
DATABASE_POOL_SIZE=10

# 连接池溢出上限
DATABASE_MAX_OVERFLOW=20

# 连接回收周期（秒）
DATABASE_POOL_RECYCLE=3600

# 取出连接前健康检查
DATABASE_POOL_PRE_PING=true

# ===========================================================================
# LOG — 日志配置（三 sink：console + 文本 + JSON）
# ===========================================================================
# 全局日志级别
LOG_LEVEL=INFO

# 文本日志文件路径
LOG_FILE=logs/app.log

# JSON 日志文件路径
LOG_JSON_FILE=logs/app.json.log

# 轮转策略（每日轮转）
LOG_ROTATION=1 day

# 保留时长（30 天）
LOG_RETENTION=30 days

# 按模块覆盖级别规格串
LOG_MODULE_LEVELS=

# 自定义文本格式模板（空串=core 默认统一模板）
LOG_TEXT_FORMAT=

# console sink 彩色输出
LOG_COLORIZE_CONSOLE=true

# 异常 diagnose（traceback 帧变量展示；默认关闭防密钥泄漏）
LOG_DIAGNOSE_EXCEPTIONS=false

# ===========================================================================
# POOLS — 共享池配置（线程池 / HTTP 池 / LLM 信号量 / 熔断）
# ===========================================================================
# 共享线程池大小
POOLS_THREAD_POOL_SIZE=8

# HTTP 池最大连接数
POOLS_HTTP_MAX_CONNECTIONS=100

# HTTP 池 keepalive 连接数
POOLS_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# HTTP 连接建立超时（秒）
POOLS_HTTP_CONNECT_TIMEOUT_SECONDS=5.0

# HTTP 单请求总超时（秒）
POOLS_HTTP_TIMEOUT_SECONDS=30.0

# LLM 全局并发信号量上限（条目级回落值）
POOLS_LLM_SEMAPHORE_LIMIT=5

# LLM 单请求超时（秒；网关消费）
POOLS_LLM_REQUEST_TIMEOUT_SECONDS=120

# 熔断失败阈值（连续失败次数）
POOLS_CB_FAIL_MAX=5

# 熔断冷却秒数
POOLS_CB_RESET_TIMEOUT_SECONDS=60

# ===========================================================================
# LLM — 默认端点 env 面（模型注册表经 config.yaml 配置）
# ===========================================================================
# 默认端点 API 基础 URL
LLM_BASE_URL=

# 默认端点 API Key
LLM_API_KEY=

# 默认端点模型名
LLM_MODEL=

# 每次生成位置回传的前 N 候选数（≥1；空值 = 省略该字段）
LLM_TOP_LOGPROBS=20

# 提示词 token logprobs 数（≥1；空值 = 省略该字段；流式请求恒省略）
LLM_PROMPT_LOGPROBS=20

# 全局每日模型调用行数上限（0 = 不限；有效上限 10,000——计数页帽 50×200；按 usage 记录计数，跨 worker 近似一致）
LLM_DAILY_BUDGET_GLOBAL=0

# 单人格每日模型调用行数上限（0 = 不限；有效上限 10,000——计数页帽 50×200；仅人格上下文调用受约束）
LLM_DAILY_BUDGET_PERSONA=0

# ===========================================================================
# LLM.INTIMATE — 亲密回复独立通道（默认关闭；base_url / api_key / model 三项齐全且开关开启才生效）
# ===========================================================================
# 是否开启亲密通道路由（默认关闭；需配置齐全）
LLM_INTIMATE_ENABLED=false

# 亲密端点 API 基础 URL（空=未配置）
LLM_INTIMATE_BASE_URL=

# 亲密端点 API Key（空=未配置；repr 不泄露）
LLM_INTIMATE_API_KEY=

# 亲密端点模型名（空=未配置）
LLM_INTIMATE_MODEL=

# 亲密通道缺省采样温度（None=不注入）
LLM_INTIMATE_TEMPERATURE=

# 触发亲密通道的最低亲密等级（0-3）
LLM_INTIMATE_MIN_INTIMACY_LEVEL=2

# ===========================================================================
# SEEKDB — 检索存储配置（enabled=False 走 SQLite 回退；密码经 SEEKDB_PASSWORD 间接）
# ===========================================================================
# 是否启用 SeekDB 检索存储（False = SQLite 回退）
SEEKDB_ENABLED=false

# SeekDB 服务地址
SEEKDB_HOST=127.0.0.1

# SeekDB MySQL 线协议端口
SEEKDB_PORT=2881

# SeekDB 连接用户名
SEEKDB_USER=root

# SeekDB 密码环境变量名
SEEKDB_PASSWORD_ENV=

# SeekDB 连接库名
SEEKDB_DATABASE=test

# 向量维度（须与 embed 模型输出一致）
SEEKDB_VECTOR_DIM=1024

# 连接池常驻连接数
SEEKDB_POOL_MIN=1

# 连接池连接上限
SEEKDB_POOL_MAX=4

# ===========================================================================
# CHANNELS.TELEGRAM — Telegram 通道配置（机器人令牌经 TELEGRAM_BOT_TOKEN 间接）
# ===========================================================================
# 是否启用 Telegram 通道
TELEGRAM_ENABLED=false

# bot token 环境变量名
TELEGRAM_BOT_TOKEN_ENV=

# Bot API 基础 URL
TELEGRAM_API_BASE=https://api.telegram.org

# getUpdates 长轮询超时秒数（Bot API 上限 50）
TELEGRAM_POLL_TIMEOUT_SECONDS=25

# 属主会话 ID（duty 通知目标；None = 未配置）
TELEGRAM_OWNER_CHAT_ID=

# 退避基数秒
TELEGRAM_BACKOFF_BASE_SECONDS=1.0

# 退避封顶秒数
TELEGRAM_BACKOFF_MAX_SECONDS=60.0

# 通道状态目录（offset 持久化）
TELEGRAM_STATE_DIR=data/channels

# ===========================================================================
# CHANNELS.QQ — QQ 通道配置（NapCat OneBot v11；令牌经 QQ_ACCESS_TOKEN / QQ_WEBHOOK_TOKEN 间接）
# ===========================================================================
# 是否启用 QQ 通道
QQ_ENABLED=false

# NapCat HTTP API 基础 URL
QQ_HTTP_API_BASE_URL=http://127.0.0.1:3000

# 出站 access token 环境变量名
QQ_ACCESS_TOKEN_ENV=

# 入站 webhook 校验 token 环境变量名（生产环境通道启用时强制非空）
QQ_WEBHOOK_TOKEN_ENV=

# 单次动作请求超时（秒）
QQ_REQUEST_TIMEOUT_SECONDS=15.0

# ===========================================================================
# CHANNELS.WECOM — 企业微信智能机器人长连接配置（默认关闭；订阅凭据 = BotID + Secret，密钥经 WECOM_SECRET 间接）
# ===========================================================================
# 是否启用企业微信智能机器人长连接通道
WECOM_ENABLED=false

# 智能机器人 BotID（enabled=true 时必填）
WECOM_BOT_ID=

# 长连接专用密钥的环境变量名
WECOM_SECRET_ENV=

# 长连接 WebSocket 端点
WECOM_WS_ENDPOINT=wss://openws.work.weixin.qq.com

# 单条命令应答超时（秒）
WECOM_REQUEST_TIMEOUT_SECONDS=15.0

# 应用层心跳间隔（秒——官方建议 30）
WECOM_HEARTBEAT_INTERVAL_SECONDS=30.0

# 心跳应答超时（秒——超时判定连接失效）
WECOM_HEARTBEAT_TIMEOUT_SECONDS=10.0

# WebSocket 握手超时（秒）
WECOM_OPEN_TIMEOUT_SECONDS=10.0

# 重连退避基数秒
WECOM_BACKOFF_BASE_SECONDS=1.0

# 重连退避封顶秒数
WECOM_BACKOFF_MAX_SECONDS=60.0

# 重连退避抖动幅度比例（0-1）
WECOM_BACKOFF_JITTER_RATIO=0.3

# 消息回调回复有效期（秒——官方 24 小时）
WECOM_REPLY_WINDOW_SECONDS=86400.0

# ===========================================================================
# CHANNELS.DOUYIN — 抖音 web 通道配置（默认关闭；复用浏览器 sidecar 的已登录页面，登录态是 profile cookie，无独立密钥键）
# ===========================================================================
# 是否启用抖音 web 通道
DOUYIN_ENABLED=false

# 会话页 URL（空 = 不导航，沿用 sidecar 当前页面）
DOUYIN_CHAT_URL=

# 目标会话标识（空 = 由页面 URL 推断 / default 兜底）
DOUYIN_CONVERSATION_ID=

# 采集轮询间隔秒数
DOUYIN_POLL_INTERVAL_SECONDS=5.0

# 单次采集消息上限（1-100）
DOUYIN_MAX_MESSAGES_PER_POLL=20

# 轮询失败退避基数秒
DOUYIN_BACKOFF_BASE_SECONDS=2.0

# 退避封顶秒数
DOUYIN_BACKOFF_MAX_SECONDS=60.0

# ===========================================================================
# CHANNELS.SMS_FORWARDER — SmsForwarder 短信 / 通知转发通道配置（默认关闭；仅入站；令牌经 SMS_FORWARDER_TOKEN 直接配置）
# ===========================================================================
# 是否启用 SmsForwarder 入站通道
SMS_FORWARDER_ENABLED=false

# 入站校验 token（空 = 鉴权关闭；手机端以请求头或查询参数携带同一值）
SMS_FORWARDER_TOKEN=

# 是否接收 kind=notification 的转发（False = 仅短信；通知事件确认丢弃）
SMS_FORWARDER_NOTIFICATIONS_ENABLED=false

# 属主号码 / 联系名清单（逗号分隔；空 = 全部发送者按 peer 落档）
SMS_FORWARDER_OWNER_NUMBERS=

# ===========================================================================
# DUTY — 值班轮配置（charter 工具循环 + 报告属主投递）
# ===========================================================================
# 是否启用值班轮
DUTY_ENABLED=false

# 每日值班时刻（HH:MM）
DUTY_DAILY_AT=22:00

# 单轮工具调用步数上限
DUTY_MAX_TOOL_STEPS=8

# 值班报告是否投递属主
DUTY_REPORT_TO_OWNER=true

# 值班任务书覆写（None = 正典模板）
DUTY_CHARTER_TEXT=

# ===========================================================================
# DREAM_SCHEDULE — 夜间梦境定时触发配置
# ===========================================================================
# 是否启用梦境定时调度
DREAM_SCHEDULE_ENABLED=false

# 每日梦境时刻（HH:MM）
DREAM_SCHEDULE_DAILY_AT=03:00

# ===========================================================================
# SCHEDULER — 中央调度器配置（自研异步循环）
# ===========================================================================
# 调度器 tick 循环间隔秒
SCHEDULER_TICK_SECONDS=1.0

# ===========================================================================
# TOOLS_SANDBOX — 工具沙盒配置（可选运行时；令牌经 SANDBOX_TOKEN 间接）
# ===========================================================================
# 是否启用工具沙盒
TOOLS_SANDBOX_ENABLED=false

# 沙盒服务基础 URL
TOOLS_SANDBOX_BASE_URL=http://127.0.0.1:8765

# 鉴权 token 环境变量名
TOOLS_SANDBOX_TOKEN_ENV=

# 单次请求超时（invoke / 健康探测共用）
TOOLS_SANDBOX_REQUEST_TIMEOUT_SECONDS=15.0

# ===========================================================================
# TOOLS_BROWSER_SIDECAR — 浏览器 sidecar 配置（可选运行时；令牌经 BROWSER_SIDECAR_TOKEN 间接；容器侧 BROWSER_SIDECAR_* 键见 compose）
# ===========================================================================
# 是否启用浏览器 sidecar
TOOLS_BROWSER_SIDECAR_ENABLED=false

# sidecar 服务基础 URL
TOOLS_BROWSER_SIDECAR_BASE_URL=http://127.0.0.1:8766

# 鉴权 token 环境变量名
TOOLS_BROWSER_SIDECAR_TOKEN_ENV=

# 单次请求超时（invoke / 健康探测共用）
TOOLS_BROWSER_SIDECAR_REQUEST_TIMEOUT_SECONDS=30.0

# ===========================================================================
# VOICE.TTS — 语音合成配置（CosyVoice3 服务端点）
# ===========================================================================
# 是否启用 TTS 语音合成
VOICE_TTS_ENABLED=false

# CosyVoice 包装服务基础 URL
VOICE_TTS_BASE_URL=http://127.0.0.1:9880

# 用量记账模型条目名
VOICE_TTS_MODEL_ENTRY=cosyvoice3

# 单次合成请求超时（秒）
VOICE_TTS_REQUEST_TIMEOUT_SECONDS=30.0

# 缺省发音人（CosyVoice 预置 speaker）
VOICE_TTS_DEFAULT_SPEAKER=中文女

# 缺省语速（0.5-2.0）
VOICE_TTS_DEFAULT_SPEED=1.0

# 全局每日 TTS 合成调用数上限（0 = 不限；有效上限 10,000——计数页帽 50×200；按 usage 行计数，跨 worker 近似一致）
TTS_DAILY_BUDGET_GLOBAL=0

# 单人格每日 TTS 合成调用数上限（0 = 不限；有效上限 10,000——计数页帽 50×200；仅人格上下文调用受约束）
TTS_DAILY_BUDGET_PERSONA=0

# 流式合成通道开关（False = 走既有整句批量合成；失败自动回退批量）
VOICE_TTS_STREAMING_ENABLED=false

# CosyVoice 流式合成 WebSocket 端点（部署契约见 tts_stream_client）
VOICE_TTS_STREAMING_BASE_URL=ws://127.0.0.1:9880/realtime

# 流式合成握手 model 字段值
VOICE_TTS_STREAMING_MODEL=cosyvoice3

# 流式合成握手 / 分片等待超时（秒）
VOICE_TTS_STREAMING_TIMEOUT_SECONDS=10.0

# 流式合成输出 PCM16 采样率（Hz——下行 WAV 封装用）
VOICE_TTS_STREAMING_SAMPLE_RATE_HZ=24000

# ===========================================================================
# VOICE.ASR — 语音识别配置（Qwen3-ASR 服务端点）
# ===========================================================================
# 是否启用 ASR 语音识别
VOICE_ASR_ENABLED=false

# Qwen3-ASR 服务基础 URL
VOICE_ASR_BASE_URL=http://127.0.0.1:8082

# 用量记账模型条目名（兼模型 id）
VOICE_ASR_MODEL_ENTRY=qwen3-asr-0.6b

# 单次转写请求超时（秒）
VOICE_ASR_REQUEST_TIMEOUT_SECONDS=60.0

# 缺省语言提示（None = 端点自动检测）
VOICE_ASR_LANGUAGE=

# ASR 上传请求体上限（字节；25MB 量级——音频体积天然大于截图，与 look_at 图像 10MB 上限同为资源面守卫）
VOICE_ASR_MAX_UPLOAD_BYTES=26214400

# 全局每日 ASR 转写调用数上限（0 = 不限；有效上限 10,000——计数页帽 50×200；按 usage 行计数，跨 worker 近似一致）
ASR_DAILY_BUDGET_GLOBAL=0

# 单人格每日 ASR 转写调用数上限（0 = 不限；有效上限 10,000——计数页帽 50×200；仅人格上下文调用受约束）
ASR_DAILY_BUDGET_PERSONA=0

# 流式识别通道开关（False = 走既有整段批量转写；失败自动回退批量）
VOICE_ASR_STREAMING_ENABLED=false

# Qwen3-ASR 流式识别 WebSocket 端点（部署契约见 asr_stream_client）
VOICE_ASR_STREAMING_BASE_URL=ws://127.0.0.1:8082/v1/realtime

# 流式识别握手 model 字段值
VOICE_ASR_STREAMING_MODEL=qwen3-asr-flash-realtime

# 流式识别握手 / 事件等待超时（秒）
VOICE_ASR_STREAMING_TIMEOUT_SECONDS=5.0

# ===========================================================================
# REALTIME_VOICE — 实时语音全双工会话配置（默认关闭；VAD 双阈值 / 静音窗 / 句切上限 / 音频队列与时长上限 / 打断开关）
# ===========================================================================
# 实时语音总闸（False = WS 端点拒绝连接）
REALTIME_VOICE_ENABLED=false

# 上行 PCM 采样率（Hz）
REALTIME_VOICE_SAMPLE_RATE_HZ=16000

# 上行声道数
REALTIME_VOICE_CHANNELS=1

# 起说能量阈值（归一化 0-1）
REALTIME_VOICE_VAD_SPEECH_RMS_THRESHOLD=0.06

# 断句能量阈值（滞回下沿 0-1）
REALTIME_VOICE_VAD_SILENCE_RMS_THRESHOLD=0.03

# 起说防抖帧数（连续达标帧）
REALTIME_VOICE_VAD_START_CONSECUTIVE_FRAMES=3

# 最短有效语音（毫秒）
REALTIME_VOICE_VAD_MIN_SPEECH_MS=300

# 静音结束窗口（毫秒）
REALTIME_VOICE_VAD_SILENCE_END_MS=700

# 单段语音上限（毫秒）
REALTIME_VOICE_VAD_MAX_SEGMENT_MS=15000

# 中途转写节流间隔（毫秒；0 = 关闭）
REALTIME_VOICE_PARTIAL_TRANSCRIPT_INTERVAL_MS=800

# 中途转写最短已积累语音（毫秒）
REALTIME_VOICE_PARTIAL_MIN_SPEECH_MS=600

# 助手单句字符上限
REALTIME_VOICE_SENTENCE_MAX_CHARS=80

# 下行 TTS 音频分片字节数
REALTIME_VOICE_TTS_CHUNK_BYTES=16384

# 逐句 TTS 队列上限（句；溢出丢最旧）
REALTIME_VOICE_TTS_QUEUE_MAX=32

# 音频入队上限（块；溢出丢最旧）
REALTIME_VOICE_AUDIO_QUEUE_MAX_CHUNKS=64

# 单次批量出队块数上限
REALTIME_VOICE_AUDIO_BATCH_MAX_CHUNKS=8

# 单会话最长时长（毫秒）
REALTIME_VOICE_MAX_SESSION_MS=600000

# 空闲超时（毫秒）
REALTIME_VOICE_IDLE_TIMEOUT_MS=60000

# 心跳建议间隔（毫秒）
REALTIME_VOICE_HEARTBEAT_INTERVAL_MS=15000

# 打断开关
REALTIME_VOICE_BARGE_IN_ENABLED=true

# 回声消除期望公告（False = ready 公告 aec=false——无 AEC 调试环境）
REALTIME_VOICE_AEC_ENABLED=true

# 进程内并发会话上限（超限 1013 拒绝）
REALTIME_VOICE_MAX_SESSIONS=2

# ===========================================================================
# VOICEPRINT — 声纹档案配置（默认关闭；说话人向量服务端点 + 阈值 / 样本门槛 / 保存期）
# ===========================================================================
# 是否启用声纹识别
VOICEPRINT_ENABLED=false

# 说话人向量服务基础 URL（空 = 未配置提供方，整功能关闭）
VOICEPRINT_EMBEDDING_BASE_URL=

# 说话人向量端点路径
VOICEPRINT_EMBEDDING_PATH=/embedding

# 说话人向量模型名
VOICEPRINT_EMBEDDING_MODEL=voiceprint-embedding

# 说话人向量提取请求超时（秒）
VOICEPRINT_REQUEST_TIMEOUT_SECONDS=30.0

# 校验通过所需的余弦相似度阈值（0-1）
VOICEPRINT_SIMILARITY_THRESHOLD=0.75

# 一次注册至少提交的样本数
VOICEPRINT_MIN_SAMPLES=3

# 单发送者样本档案上限
VOICEPRINT_MAX_SAMPLES=20

# 注册样本最短时长（毫秒；短于此时长拒收）
VOICEPRINT_MIN_SAMPLE_DURATION_MS=1500

# 校验音频最短时长（毫秒；短音频拒识）
VOICEPRINT_MIN_VERIFY_DURATION_MS=1000

# 注册样本最低采样率（赫兹）
VOICEPRINT_MIN_SAMPLE_RATE_HZ=8000

# 单样本音频字节上限（10MB 量级）
VOICEPRINT_MAX_UPLOAD_BYTES=10485760

# 单次注册请求的样本条数上限（资源面守卫）
VOICEPRINT_MAX_BATCH_SAMPLES=20

# 样本与向量最长保存天数（到期自动清除）
VOICEPRINT_RETENTION_DAYS=365

# 样本文件落盘根目录
VOICEPRINT_STORAGE_DIR=data/voiceprints

# 全局每日声纹向量提取调用数上限（0 = 不限；有效上限 10,000——计数页帽 50×200；按 usage 行计数，跨 worker 近似一致）
VOICEPRINT_DAILY_BUDGET_GLOBAL=0

# 单人格每日声纹向量提取调用数上限（0 = 不限；有效上限 10,000——计数页帽 50×200；仅人格上下文调用受约束）
VOICEPRINT_DAILY_BUDGET_PERSONA=0

# ===========================================================================
# STICKER — 表情包库配置（默认关闭；哈希去重 / VLM 标注 / 通道表情收发）
# ===========================================================================
# 是否启用表情包库
STICKER_ENABLED=false

# 表情包文件落盘根目录
STICKER_STORAGE_DIR=data/stickers

# 单文件字节上限（5MB 量级）
STICKER_MAX_UPLOAD_BYTES=5242880

# 单条表情包标签数上限
STICKER_MAX_TAGS=8

# 单个标签最长字符数
STICKER_TAG_MAX_LENGTH=24

# 描述最长字符数
STICKER_DESCRIPTION_MAX_LENGTH=500

# 来源 / 授权备注最长字符数（上传必填）
STICKER_SOURCE_NOTE_MAX_LENGTH=512

# 单次批量上传条数上限
STICKER_MAX_BATCH_ITEMS=20

# 通道桥回表情开关（仅 STICKER_ENABLED=true 时生效）
STICKER_CHANNEL_REPLY_ENABLED=true

# ===========================================================================
# SEARCH.WEB — 联网搜索运营配置（默认关闭；密钥经 SEARCH_BOCHA_API_KEY / SEARCH_ZHIPU_API_KEY 间接——条目表在 config.yaml search 节管理）
# ===========================================================================
# 是否启用联网搜索能力
SEARCH_ENABLED=false

# 是否注册 web_search 工具（需 enabled 同时为真）
SEARCH_TOOL_ENABLED=false

# 单人格每日搜索调用数预算
SEARCH_DAILY_BUDGET_PER_PERSONA=50

# 全局每日搜索调用数预算
SEARCH_DAILY_BUDGET_GLOBAL=200

# provider 失败降级冷却秒数
SEARCH_COOLDOWN_SECONDS=60

# ===========================================================================
# RHYTHM — 拟人节律层配置（默认关闭；HH:MM 为 naive 本地时间——调度器同口径）
# ===========================================================================
# 是否启用节律门控（False = 门直通）
RHYTHM_ENABLED=false

# 就寝时刻（HH:MM 24 小时制，含端点）
RHYTHM_BEDTIME=23:30

# 醒来时刻（HH:MM 24 小时制，不含端点）
RHYTHM_WAKE_TIME=08:00

# 时区约定说明（naive 本地墙钟——scheduler daily_at 同约定；文档锚点不参与计算）
RHYTHM_TIMEZONE_NOTE=naive-local

# 回复延迟下限毫秒（log-uniform 采样域下界）
RHYTHM_REPLY_DELAY_MIN_MS=1500

# 回复延迟上限毫秒（log-uniform 采样域上界）
RHYTHM_REPLY_DELAY_MAX_MS=45000

# 打字速度（毫秒/字符）
RHYTHM_TYPING_SPEED_MS_PER_CHAR=45

# 打字基础耗时毫秒（起手耗时）
RHYTHM_TYPING_BASE_MS=800

# 快答概率（快尾采样机会）
RHYTHM_BURST_PROBABILITY=0.12

# ===========================================================================
# FLOW — 心流门控配置（默认关闭；延迟 / 合并批次经中央调度器一次性作业排程）
# ===========================================================================
# 是否启用心流门控（False = 直通）
FLOW_ENABLED=false

# 连发窗口毫秒（窗口内计数）
FLOW_BURST_WINDOW_MS=4000

# 连发合并阈值（窗口内条数）
FLOW_BURST_COUNT=3

# 合并静默毫秒（最后一次入站后的等待时长）
FLOW_MERGE_QUIET_MS=2500

# 单次合并承载的消息条数上限
FLOW_MERGE_MAX_MESSAGES=5

# 两条回复之间的最小间隔毫秒
FLOW_MIN_REPLY_GAP_MS=1200

# 未读积压转延迟的条数阈值
FLOW_BACKLOG_DEFER_THRESHOLD=6

# 积压每超出阈值一条追加的延迟毫秒
FLOW_BACKLOG_DEFER_STEP_MS=8000

# 积压延迟上限毫秒
FLOW_BACKLOG_DEFER_MAX_MS=90000

# 延迟任务丢失判定宽限毫秒
FLOW_PENDING_GRACE_MS=60000

# ===========================================================================
# GROUP_PERSONA — 群聊多人格应答配置（默认关闭；单人格应答保持既有语义）
# ===========================================================================
# 是否启用群聊多人格应答
GROUP_PERSONA_ENABLED=false

# 单条群消息的应答人格数量上限（1-4）
GROUP_PERSONA_MAX_RESPONDERS=1

# 同一人格两次应答之间的冷却毫秒
GROUP_PERSONA_COOLDOWN_MS=60000

# ===========================================================================
# INTENT — 意图快径配置（默认开启——纯本地零成本罐头意图，绕过主 LLM）
# ===========================================================================
# 是否启用意图快径（默认开启——纯本地零成本）
INTENT_ENABLED=true

# ===========================================================================
# EMOTION — 轻情绪引擎配置（默认开启——协议解析宽容降级；驱动 M 层情绪状态）
# ===========================================================================
# 是否启用情绪引擎（默认开启——纯本地零成本）
EMOTION_ENABLED=true

# 衰减半衰期（毫秒）
EMOTION_DECAY_HALF_LIFE_MS=21600000

# 中性基线（0..1）
EMOTION_NEUTRAL_BASELINE=0.5

# 摘要阈值
EMOTION_SUMMARY_THRESHOLD=0.15

# ===========================================================================
# INJECTION — 提示词注入防御配置（默认开启——保守阈值；反击风格可选）
# ===========================================================================
# 是否启用注入防御（默认开启）
INJECTION_ENABLED=true

# 建议反击台词风格（sassy/sweet/tsun）
INJECTION_COUNTER_STYLE=sassy

# 触发提示的加权总分阈值
INJECTION_THRESHOLD=2.0

# 命中时是否注入注入提示块
INJECTION_ANTI_INJECTION_HINT=true

# ===========================================================================
# COMPLIANCE — 人格输出合规守卫配置（默认开启——一次强化重试）
# ===========================================================================
# 是否启用合规守卫（默认开启）
COMPLIANCE_ENABLED=true

# 触发重试的加权总分阈值
COMPLIANCE_THRESHOLD=2.0

# 重试温度增量（叠加后夹取 2.0 上限）
COMPLIANCE_TEMPERATURE_BUMP=0.2

# 命中后的最大重试次数（0 / 1）
COMPLIANCE_MAX_RETRIES=1

# ===========================================================================
# ENV — 运行环境标识
# ===========================================================================
# 运行环境标识（local / dev / test / prod）
ENV=local
